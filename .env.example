# ─────────────────────────────────────────────
# Auth.js (NextAuth)
# ─────────────────────────────────────────────
# openssl rand -base64 32  으로 생성
AUTH_SECRET=
# 로컬은 http://localhost:3000, 배포 시 실제 도메인
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# 카카오 로그인
# https://developers.kakao.com  →  내 애플리케이션
# ─────────────────────────────────────────────
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# ─────────────────────────────────────────────
# 구글 드라이브 (서버 전용 · 절대 클라이언트 노출 금지)
# https://console.cloud.google.com  →  API 및 서비스
#
# 주의 1. scope 는 반드시 drive.file 만 사용한다.
#         drive 전체 scope 는 제한 범위라 검증 심사가 붙는다.
# 주의 2. OAuth 동의 화면을 "프로덕션"으로 게시할 것.
#         테스트 상태면 refresh token 이 7일 만에 만료된다.
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 아래 두 값이 "저장 계정"을 결정한다.
# 계정을 교체할 때는 이 두 줄만 갈아끼우면 되고 코드는 건드리지 않는다.
# 단, drive.file 특성상 이전 계정으로 올린 파일은 새 계정에서 보이지 않는다.
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=
