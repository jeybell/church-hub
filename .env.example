# ─────────────────────────────────────────────
# Auth.js (NextAuth)
# ─────────────────────────────────────────────
# openssl rand -base64 32  으로 생성
AUTH_SECRET=
# 로컬은 http://localhost:3000, 배포 시 실제 도메인
NEXTAUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────
# 카카오 로그인
# https://developers.kakao.com  →  내 애플리케이션
# ─────────────────────────────────────────────
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=

# ─────────────────────────────────────────────
# 구글 드라이브 (서버 전용 · 절대 클라이언트 노출 금지)
# https://console.cloud.google.com  →  API 및 서비스
#
# 주의 1. 현재 scope 는 drive (전체 읽기+쓰기) 다. 교인이 드라이브에 직접
#         올린 파일도 앱에서 보여야 해서 넓혔다. 제한 범위 scope 라
#         동의 화면을 "프로덕션"으로 게시하려면 검증 심사가 붙는다.
# 주의 2. 동의 화면이 테스트 상태면 refresh token 이 7일 만에 만료된다.
#         만료되면 npm run setup:drive 를 다시 실행한다.
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 아래 두 값이 "저장 계정"을 결정한다.
# 계정을 교체할 때는 이 두 줄만 갈아끼우면 되고 코드는 건드리지 않는다.
# 단, 계정을 바꾸면 DRIVE_ROOT_FOLDER_ID 도 새 계정의 폴더로 바꿔야 한다.
GOOGLE_REFRESH_TOKEN=
DRIVE_ROOT_FOLDER_ID=

# ─────────────────────────────────────────────
# Supabase (서버 전용 · 절대 클라이언트 노출 금지)
# 행사 게시글과 첨부 목록을 여기에 저장한다.
#
# 대시보드 → Project Settings → API 에서 복사한다.
# 테이블은 RLS 가 켜져 있고 정책이 없어 anon 키로는 아무것도 못 읽는다.
# 접근은 서버에서 service role 키로만 이뤄진다.
# ─────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────
# Vercel Deploy Hook (선택)
#
# 환경변수만 바꿨을 때 npm run redeploy 로 배포를 다시 굽기 위한 URL.
# Vercel 프로젝트 → Settings → Git → Deploy Hooks 에서 만든다.
# URL 자체가 배포 트리거 권한이므로 커밋하지 않는다.
# ─────────────────────────────────────────────
VERCEL_DEPLOY_HOOK_URL=
